{
  "version": "2",
  "title": "Adaptive v3",
  "author": "Decent",
  "notes": "Adaptive flow-driven extraction profile.",
  "beverage_type": "espresso",
  "steps": [
    {
      "name": "Prefill",
      "pump": "flow",
      "transition": "fast",
      "temperature": "93",
      "sensor": "coffee",
      "seconds": "5",
      "volume": "100",
      "flow": "8",
      "pressure": "3",
      "limiter": {
        "value": "0",
        "range": "0.6"
      }
    },
    {
      "name": "Fill",
      "pump": "flow",
      "transition": "fast",
      "temperature": "93",
      "sensor": "coffee",
      "seconds": "12",
      "volume": "100",
      "flow": "8",
      "pressure": "3",
      "exit": {
        "type": "pressure",
        "condition": "over",
        "value": "3"
      },
      "limiter": {
        "value": "0",
        "range": "0.6"
      }
    },
    {
      "name": "Compressing",
      "pump": "pressure",
      "transition": "fast",
      "temperature": "88",
      "sensor": "coffee",
      "seconds": "12",
      "volume": "100",
      "pressure": "3",
      "flow": "6.8",
      "exit": {
        "type": "flow",
        "condition": "under",
        "value": "3"
      },
      "limiter": {
        "value": "0",
        "range": "0.6"
      }
    },
    {
      "name": "Dripping",
      "pump": "pressure",
      "transition": "fast",
      "temperature": "88",
      "sensor": "coffee",
      "seconds": "6",
      "volume": "0",
      "pressure": "0.1",
      "flow": "6.8",
      "limiter": {
        "value": "0",
        "range": "0.6"
      }
    },
    {
      "name": "Pressurize",
      "pump": "pressure",
      "transition": "fast",
      "temperature": "88",
      "sensor": "coffee",
      "seconds": "6",
      "volume": "100",
      "pressure": "11",
      "flow": "0",
      "exit": {
        "type": "pressure",
        "condition": "over",
        "value": "7.7"
      },
      "limiter": {
        "value": "3.5",
        "range": "0.6"
      }
    },
    {
      "name": "Extraction start",
      "pump": "flow",
      "transition": "fast",
      "temperature": "88",
      "sensor": "coffee",
      "seconds": "0",
      "volume": "0",
      "flow": "1.5",
      "pressure": "3",
      "exit": {
        "type": "pressure",
        "condition": "over",
        "value": "0"
      },
      "limiter": {
        "value": "8.6",
        "range": "0.6"
      }
    },
    {
      "name": "Extraction",
      "pump": "flow",
      "transition": "fast",
      "temperature": "88",
      "sensor": "coffee",
      "seconds": "60",
      "volume": "100",
      "flow": "3.5",
      "pressure": "3",
      "limiter": {
        "value": "8.6",
        "range": "0.6"
      }
    }
  ],
  "tank_temperature": "0",
  "target_weight": "36",
  "target_volume": "36",
  "target_volume_count_start": "3"
}
