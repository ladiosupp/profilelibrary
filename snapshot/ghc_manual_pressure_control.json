      "pump": "pressure",
      "transition": "fast",
      "temperature": "88",
      "sensor": "coffee",
      "seconds": "3",
      "volume": "0",
      "pressure": "0",
      "flow": "0",
      "limiter": {
        "value": "0",
        "range": "0.6"
      }
    },
    {
      "name": "rise and hold",
      "pump": "pressure",
      "transition": "fast",
      "temperature": "88",
      "sensor": "coffee",
      "seconds": "57",
      "volume": "0",
      "pressure": "0",
      "flow": "0",
      "limiter": {
        "value": "0",
        "range": "0.6"
      }
    },
    {
      "name": "decline",
      "pump": "pressure",
      "transition": "smooth",
      "temperature": "88",
      "sensor": "coffee",
      "seconds": "60",
      "volume": "0",
      "pressure": "0",
      "flow": "0",
      "limiter": {
        "value": "0",
        "range": "0.6"
      }
    }
  ],
  "tank_temperature": "0",
  "target_weight": "0",
  "target_volume": "0",
  "target_volume_count_start": "1"
